# Пример настроек окружения для Fasterbook.
# Скопируйте этот файл в .env.local и вставьте свои значения.
# .env.local не попадает в git (см. .gitignore). Сам этот файл — без настоящих ключей.
#
# Где взять значения: Supabase Dashboard → ваш проект → кнопка «Connect»
# (или Project Settings → API Keys / Data API).

# Project URL, например https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (начинается с sb_publishable_...). Его можно показывать в браузере.
# НЕ вставляйте сюда secret key (sb_secret_...) и service_role — они дают полный доступ к базе.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
